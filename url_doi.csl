<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" default-locale="en-US">
  <info>
    <title>DOI only (full URL)</title>
    <id>http://www.zotero.org/styles/digital-object-identifier-only-full-url</id>
    <link href="http://www.zotero.org/styles/digital-object-identifier-only-full-url" rel="self"/>
    <author>
      <name>Raphael Grolimund (modified)</name>
    </author>
    <category citation-format="author-date"/>
    <summary>Outputs only the DOI in full URL form for in-text citations.</summary>
    <updated>2025-08-08T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale>
    <terms>
      <term name="online">&#160;</term>
    </terms>
  </locale>

  <macro name="doi-url">
    <text variable="DOI" prefix="https://doi.org/"/>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <text macro="doi-url"/>
    </layout>
  </citation>

  <bibliography>
    <layout>
      <choose>
        <if variable="DOI">
          <text macro="doi-url"/>
        </if>
        <else>
          <text term="online"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
